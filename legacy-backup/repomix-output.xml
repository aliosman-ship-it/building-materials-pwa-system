              </tr>
            </thead>
            <tbody id="customer-statement-tbody"></tbody>
            <tfoot>
              <tr>
                <th colspan="3">الإجمالي</th>
                <th id="customer-statement-debits" class="statement-money">0 ر.س</th>
                <th id="customer-statement-credits" class="statement-money">0 ر.س</th>
              </tr>
            </tfoot>
          </table>
        </div>
        <section class="customer-statement-balance">
          <div>
            <span>الرصيد النهائي المتبقي على العميل</span>
            <small>محسوب حسب سجل حساب العميل</small>
          </div>
          <strong id="customer-statement-balance">0 ر.س</strong>
        </section>
        <footer class="customer-statement-footer">
          <span>صدر هذا الكشف من نظام إدارة شركة سعد فيصل القحطاني لتوريد مواد البناء.</span>
          <span>يعتمد الكشف على البيانات المحفوظة محلياً في هذا الجهاز.</span>
        </footer>
      </article>
      <div class="customer-statement-actions no-print">
        <button id="print-customer-statement-btn" type="button" class="customer-statement-print-btn">
          <i class="fa-solid fa-print" aria-hidden="true"></i>
          <span>طباعة / حفظ PDF</span>
        </button>
        <button id="close-customer-statement-btn" type="button" class="customer-statement-close-btn" aria-label="إغلاق كشف الحساب">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- نافذة مودال: إدارة وإضافة العملاء (Client Management Modal) -->
  <div id="client-modal" class="app-modal fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="client-modal-title">
    <div class="app-modal-dialog bg-white rounded-2xl max-w-md w-full max-h-[85vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden animate-fade-in">
      <div class="app-modal-header bg-slate-900 text-white px-5 py-4 flex items-center justify-between shrink-0">
        <h3 class="text-base font-bold flex items-center gap-2">
          <i class="fa-solid fa-users text-amber-400"></i>
          <span id="client-modal-title">إدارة قائمة العملاء</span>
        </h3>
        <button id="close-client-modal-btn" type="button" class="app-modal-close text-slate-400 hover:text-white text-lg" aria-label="إغلاق إدارة العملاء">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      
      <div class="app-modal-content p-5 space-y-4 flex-1 min-h-0 overflow-y-auto">
        <!-- نموذج إضافة عميل جديد -->
        <form id="add-client-form" class="flex gap-2">
          <input type="text" id="new-client-name" placeholder="أدخل اسم العميل أو الشركة..." required class="flex-grow h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:bg-white">
        </form>

        <!-- قائمة العملاء الحالية -->
        <div class="space-y-2">
          <p class="text-xs font-bold text-slate-500">العملاء المسجلون حالياً:</p>
          <ul id="clients-list" class="max-h-60 overflow-y-auto divide-y divide-slate-100 border border-slate-200 rounded-xl bg-slate-50/50">
            <!-- تعبأ ديناميكياً -->
          </ul>
        </div>

      </div>
      
      <div class="bg-slate-50 px-5 py-3 border-t border-slate-200 flex items-center justify-between gap-2 shrink-0">
        <button type="submit" form="add-client-form" class="h-11 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl text-xs transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i>
          <span>إضافة</span>
        </button>
        <button type="button" id="done-client-modal-btn" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg text-xs font-bold transition">
          إغلاق
        </button>
      </div>
    </div>
  </div>

  <!-- نافذة مودال: تخصيص مواد وأسعار العملاء -->
  <div id="client-catalog-modal" class="app-modal fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="client-catalog-modal-title">
    <div class="app-modal-dialog bg-white rounded-2xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden animate-fade-in">
      <div class="app-modal-header bg-slate-900 text-white px-5 py-4 flex items-center justify-between shrink-0">
        <h3 id="client-catalog-modal-title" class="text-base font-bold flex items-center gap-2">
          <i class="fa-solid fa-tags text-amber-400"></i>
          <span>تخصيص أسعار ومواد العملاء</span>
        </h3>
        <button id="close-client-catalog-modal-btn" type="button" class="app-modal-close text-slate-400 hover:text-white text-lg" aria-label="إغلاق تخصيص أسعار العملاء">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="app-modal-content p-5 space-y-5 flex-1 min-h-0 overflow-y-auto">
        <div class="space-y-1.5">
          <label for="client-catalog-client-select" class="block text-sm font-bold text-slate-700">العميل / الشركة</label>
          <select id="client-catalog-client-select" class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:bg-white"></select>
          <p class="text-xs text-slate-500">تُستخدم هذه القائمة بدلاً من المواد العامة لهذا العميل. اتركها فارغة لاستخدام الكتالوج العام.</p>
        </div>

        <div class="space-y-2">
          <h4 class="text-sm font-bold text-slate-800">المواد والأسعار المخصصة</h4>
          <div class="overflow-x-auto border border-slate-200 rounded-xl">
            <table class="w-full min-w-[560px] text-right border-collapse text-xs sm:text-sm">
              <thead>
                <tr class="bg-slate-100 text-slate-700 font-bold">
                  <th class="p-3 border-b border-slate-200">المادة / الخدمة</th>
                  <th class="p-3 border-b border-slate-200">الوحدة</th>
                  <th class="p-3 border-b border-slate-200 text-center">السعر الافتراضي (ر.س)</th>
                  <th class="p-3 border-b border-slate-200 text-center w-28">الإجراءات</th>
                </tr>
              </thead>
              <tbody id="client-catalog-list" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>

        <form id="client-catalog-form" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input id="client-catalog-material" type="text" required maxlength="120" placeholder="المادة أو الخدمة" class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:bg-white">
          <input id="client-catalog-unit" type="text" required maxlength="30" value="رد" placeholder="الوحدة" aria-label="الوحدة المخصصة" class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:bg-white">
          <input id="client-catalog-price" type="number" lang="en" min="0" step="any" required placeholder="السعر الافتراضي" aria-label="السعر الافتراضي بالريال" class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:bg-white">
        </form>
      </div>

      <div class="bg-slate-50 px-5 py-3 border-t border-slate-200 flex items-center justify-between gap-2 shrink-0">
        <button id="save-client-catalog-item-btn" type="submit" form="client-catalog-form" class="h-11 px-4 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl text-xs transition flex items-center justify-center gap-1.5 whitespace-nowrap">
          <i class="fa-solid fa-plus"></i><span>إضافة</span>
        </button>
        <button id="cancel-client-catalog-edit-btn" type="button" class="hidden h-11 px-3 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold rounded-xl text-xs transition whitespace-nowrap">
          إلغاء
        </button>
        <button type="button" id="done-client-catalog-modal-btn" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-lg text-xs font-bold transition">إغلاق</button>
      </div>
    </div>
  </div>

  <!-- نافذة مودال: تسجيل دفعة نقدية -->
  <div id="payment-modal" class="app-modal fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="payment-modal-title">
    <div class="app-modal-dialog bg-white rounded-2xl max-w-lg w-full max-h-[85vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden animate-fade-in">
      <div class="app-modal-header bg-emerald-700 text-white px-5 py-4 flex items-center justify-between shrink-0">
        <h3 id="payment-modal-title" class="text-base font-bold flex items-center gap-2">
          <i class="fa-solid fa-money-bill-wave text-emerald-200"></i>
          <span>تسجيل دفعة نقدية</span>
        </h3>
        <button id="close-payment-modal-btn" type="button" class="app-modal-close text-emerald-100 hover:text-white text-lg" aria-label="إغلاق تسجيل الدفعة">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="payment-form" class="app-modal-content p-5 space-y-4">
        <div>
          <label for="payment-client-select" class="block text-sm font-bold text-slate-700 mb-1">اختيار العميل</label>
          <select id="payment-client-select" required class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800">
            <option value="">اختر العميل</option>
          </select>
        </div>
        <div>
          <label for="payment-amount-input" class="block text-sm font-bold text-slate-700 mb-1">المبلغ المدفوع بالريال</label>
          <input id="payment-amount-input" type="number" lang="en" min="0.01" step="any" required class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800">
        </div>
        <div>
          <label for="payment-date-input" class="block text-sm font-bold text-slate-700 mb-1">التاريخ</label>
          <input id="payment-date-input" type="date" lang="en" required class="w-full h-11 px-3 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800">
        </div>
        <div>
          <label for="payment-note-input" class="block text-sm font-bold text-slate-700 mb-1">ملاحظات</label>
          <textarea id="payment-note-input" rows="3" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-800"></textarea>
        </div>
        <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
          <button id="cancel-payment-btn" type="button" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-bold transition">إلغاء</button>
          <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-bold transition">حفظ الدفعة</button>
        </div>
      </form>
    </div>
  </div>

  <!-- نافذة مودال: تعديل نقلة (Edit Trip Modal) -->
  <div id="edit-trip-modal" class="app-modal fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="edit-trip-modal-title">
    <div class="app-modal-dialog bg-white rounded-2xl max-w-lg w-full max-h-[85vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden animate-fade-in">
      <div class="app-modal-header bg-slate-900 text-white px-5 py-4 flex items-center justify-between shrink-0">
        <h3 class="text-base font-bold flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square text-emerald-400"></i>
          <span id="edit-trip-modal-title">تعديل بيانات النقلة</span>
        </h3>
        <button id="close-edit-modal-btn" type="button" class="app-modal-close text-slate-400 hover:text-white text-lg" aria-label="إغلاق تعديل النقلة">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="edit-trip-form" class="app-modal-content p-5 space-y-4 flex flex-1 min-h-0 flex-col">
        <input type="hidden" id="edit-trip-id">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1 min-h-0 overflow-y-auto">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">اسم العميل</label>
            <select id="edit-client-select" required class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800"></select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">نوع المادة / الخدمة</label>
            <select id="edit-material-select" required class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800"></select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">رقم السيارة / التريلا (اختياري)</label>
            <input type="text" id="edit-truck-input" class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">التاريخ</label>
            <input type="date" id="edit-date-input" lang="en" required class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">عدد الردود</label>
            <input type="number" id="edit-count-input" lang="en" min="1" required class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">السعر للرد (ر.س)</label>
            <input type="number" id="edit-price-input" lang="en" min="0" step="any" required class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800">
          </div>
          <div class="sm:col-span-2 flex items-center justify-between bg-emerald-50/70 border border-emerald-200 px-3 py-2 rounded-lg text-xs">
            <span class="font-bold text-emerald-800">الإجمالي المحسوب (الكمية × السعر):</span>
            <span id="edit-total-display" class="font-black text-emerald-700 text-sm">0 ر.س</span>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">ملاحظات / بون</label>
            <input type="text" id="edit-notes-input" class="w-full h-10 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs font-semibold text-slate-800">
          </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex justify-end gap-2 shrink-0">
          <button type="button" id="cancel-edit-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition">
            إلغاء
          </button>
          <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
            <i class="fa-solid fa-check"></i>
            <span>حفظ التعديلات</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- تذييل الصفحة -->
  <footer class="bg-white border-t border-slate-200 py-4 mt-auto text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p>شركة سعد فيصل القحطاني لتوريد مواد البناء &copy; 2026 - تخزين محلي آمن وفوري</p>
      <div class="flex items-center gap-4 text-slate-400">
        <span>جاهز للطباعة والفوترة</span>
        <span>•</span>
        <span>Ali.dev</span>
      </div>
    </div>
  </footer>

  <!-- حاوية إشعارات التوست -->
  <div id="toast-container"></div>

  <section id="pin-settings-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pin-settings-title">
    <form id="pin-settings-form" class="pin-settings-card">
      <div class="pin-settings-body">
        <h2 id="pin-settings-title" style="margin:0;font-size:1.25rem;font-weight:900">إعداد رمز الدخول</h2>
        <p id="pin-settings-help" style="margin:.35rem 0;color:#475569;font-size:.9rem">الرمز قفل محلي لهذا المتصفح فقط، ولا يشفر ملفات البيانات.</p>
        <div id="pin-current-field">
          <label for="pin-current-input">الرمز الحالي</label>
          <input id="pin-current-input" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="current-password">
        </div>
        <div id="pin-new-fields">
          <label for="pin-new-input">الرمز الجديد (أربعة أرقام)</label>
          <input id="pin-new-input" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="new-password">
          <label for="pin-confirm-input">تأكيد الرمز الجديد</label>
          <input id="pin-confirm-input" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="new-password">
        </div>
      </div>
      <div class="pin-settings-footer">
        <p id="pin-settings-error" class="pin-error" role="alert"></p>
        <div class="pin-settings-actions">
          <button type="submit" style="background:#047857">حفظ الرمز</button>
          <button id="remove-pin-btn" type="button" style="background:#b91c1c">إزالة الرمز</button>
          <button id="close-pin-settings-btn" type="button" style="background:#475569">إغلاق</button>
        </div>
      </div>
    </form>
  </section>

  <!-- السكربت البرمجي -->
  <script src="./JS/script.js"></script>
</body>
</html>
