/* أنماط وتنسيقات مخصصة - نظام إدارة نقل مواد البناء والمخلفات */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap');

:root {
  --font-arabic: 'Cairo', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

body {
  font-family: var(--font-arabic);
  direction: rtl;
  text-align: right;
  background-color: #f8fafc;
  color: #1e293b;
  -webkit-font-smoothing: antialiased;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.5rem;
  padding: .5rem .875rem;
  border-radius: .5rem;
  font-size: .75rem;
  font-weight: 700;
  white-space: nowrap;
  transition: background-color .15s ease-in-out;
}

.btn-success {
  color: #fff;
  background-color: #059669;
}

.btn-success:hover {
  background-color: #047857;
}

/* تحسين شريط التمرير */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: #f1f5f9;
}
::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* شارات المواد الملونة */
.badge-waste {
  background-color: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}
.badge-sand-white {
  background-color: #f0fdf4;
  color: #15803d;
  border: 1px solid #bbf7d0;
}
.badge-sand-red {
  background-color: #fff7ed;
  color: #c2410c;
  border: 1px solid #fed7aa;
}
.badge-gravel {
  background-color: #f8fafc;
  color: #475569;
  border: 1px solid #e2e8f0;
}
.badge-soil {
  background-color: #fefce8;
  color: #a16207;
  border: 1px solid #fef08a;
}
.badge-other {
  background-color: #eff6ff;
  color: #1d4ed8;
  border: 1px solid #bfdbfe;
}

/* شرائح الاختيار السريع Quick Chips */
.quick-chip {
  transition: all 0.15s ease-in-out;
  user-select: none;
}
.quick-chip:hover {
  transform: translateY(-1px);
}
.quick-chip.active {
  background-color: #0284c7;
  color: #ffffff;
  border-color: #0284c7;
  box-shadow: 0 2px 4px rgba(2, 132, 199, 0.25);
}

/* تحسين المدخلات */
input:focus, select:focus, textarea:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.2);
}

/* بطاقات الإحصاءات وتأثيرات الظل */
.stat-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
}

/* إشعارات التوست Toast */
#toast-container {
  position: fixed;
  bottom: 1.5rem;
  left: 1.5rem;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 3rem);
  max-height: calc(100dvh - 3rem);
  overflow-y: auto;
  overscroll-behavior: contain;
  gap: 0.5rem;
  pointer-events: none;
}
.toast {
  pointer-events: auto;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateY(1rem);
  opacity: 0;
}
.toast.show {
  transform: translateY(0);
  opacity: 1;
}

/* عناصر الطباعة مخفية على الشاشة وتظهر عند الطباعة. */
.print-only {
  display: none;
}

/* نافذة الطباعة المخصصة A4 */
@media print {
